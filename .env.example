# ==== تلگرام (اجباری برای دریافت سیگنال) ====
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHANNEL_ID=@my_signal_channel
TELEGRAM_NEWS_CHANNEL_ID=@my_signal_channel

# ==== امنیت اندپوینت‌ها (اجباری - یک رشته‌ی رندوم طولانی بساز) ====
CRON_SECRET=یک-رشته-رندوم-و-طولانی-بساز

# ==== ارزهایی که اسکن میشن (اختیاری - پیش‌فرض ۱۵ ارز مشخص در config.py هست) ====
SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT,XRP/USDT,ADA/USDT,DOGE/USDT,AVAX/USDT,LINK/USDT,TON/USDT

# ==== مدیریت سرمایه (اختیاری) ====
ACCOUNT_BALANCE_USDT=1000
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_WEEKLY_LOSS_PCT=7.0
MAX_DRAWDOWN_PCT=15.0

# ==== ذخیره‌سازی Upstash Redis (اختیاری ولی برای داشبورد/تاریخچه لازمه - رایگان: upstash.com) ====
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# ==== دیسکورد (اختیاری) ====
DISCORD_WEBHOOK_URL=

# ==== ایمیل (اختیاری) ====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
